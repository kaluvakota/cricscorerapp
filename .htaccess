# Cric-Scorer by Aaryush
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config(\.local)?(\.sample)?\.php|install\.lock|.*\.sql|.*\.md|.*\.py)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
# Public JSON (manifest.json, assets/academy.json) is allowed; private data/*.json is blocked by data/.htaccess
<Files "manifest.json">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Allow from all
  </IfModule>
</Files>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# Friendly page addresses (SEO)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^privacy/?$ privacy.php [L]
  RewriteRule ^terms/?$ terms.php [L]
  RewriteRule ^learn/?$ learn.php [L]
  RewriteRule ^learn/([a-z0-9-]+)/?$ learn.php?l=$1 [L,QSA]
  RewriteRule ^m/([0-9]+)/?$ match.php?id=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
